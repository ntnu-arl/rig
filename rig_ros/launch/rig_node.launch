<launch>
  <arg name="rviz" default="false" />

  <node pkg="rig" type="rig_node" name="rig_node" output="screen" clear_params="true">
    <rosparam file="$(find rig)/config/rig.yaml" command="load" />
    <rosparam file="$(find rig)/config/radar.yaml" command="load" ns="sensor"/>

    <remap from="baro" to="/vectornav_driver_node/pressure"/>
    <remap from="imu" to="/vectornav_driver_node/imu/data"/>
    <remap from="cloud" to="/radar/cloud"/>
  </node>

  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find rig)/rviz/rig.rviz" if="$(arg rviz)"/>
</launch>
